                "fontSize": 18,
                "color": {
                  "type": "palette",
                  "id": "pc_sample_muted"
                },
                "textAlign": "center",
                "fontFamily": "system",
                "fontWeight": 400,
                "lineHeight": 1.75,
                "letterSpacing": 0
