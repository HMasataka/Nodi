        { "id": "nd_docs_item_2", "name": "本文 / Start and manage a new branch", "type": "text", "x": 390, "y": 629, "width": 690, "height": 28, "content": "Start and manage a new branch.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_bullet_3", "name": "本文 / 箇条書き3の点", "type": "ellipse", "x": 374, "y": 675, "width": 5, "height": 5, "fill": "#1f2328", "stroke": "#1f2328", "strokeWidth": 0 },
        { "id": "nd_docs_item_3", "name": "本文 / Make changes and push commits", "type": "text", "x": 390, "y": 664, "width": 690, "height": 28, "content": "Make changes to a file and push them to GitHub as commits.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_bullet_4", "name": "本文 / 箇条書き4の点", "type": "ellipse", "x": 374, "y": 710, "width": 5, "height": 5, "fill": "#1f2328", "stroke": "#1f2328", "strokeWidth": 0 },
        { "id": "nd_docs_item_4", "name": "本文 / Open and merge a pull request", "type": "text", "x": 390, "y": 699, "width": 690, "height": 28, "content": "Open and merge a pull request.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_prereq_heading", "name": "本文 / Prerequisites", "type": "text", "x": 350, "y": 754, "width": 350, "height": 35, "content": "Prerequisites", "fontSize": 20, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_prereq_anchor", "name": "本文 / Prerequisites リンク", "type": "text", "x": 484, "y": 752, "width": 28, "height": 26, "content": "↗", "fontSize": 17, "color": "#57606a", "textAlign": "center" },
        { "id": "nd_docs_prereq_bullet_1", "name": "本文 / 前提条件1の点", "type": "ellipse", "x": 374, "y": 808, "width": 5, "height": 5, "fill": "#1f2328", "stroke": "#1f2328", "strokeWidth": 0 },
        { "id": "nd_docs_prereq_1", "name": "本文 / GitHub アカウント", "type": "text", "x": 390, "y": 796, "width": 456, "height": 28, "content": "You must have a GitHub account. For more information, see", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_prereq_link", "name": "本文 / アカウント作成リンク", "type": "text", "x": 836, "y": 796, "width": 254, "height": 28, "content": "Creating an account on GitHub.", "fontSize": 16, "color": "#0969da", "textAlign": "left" },
        { "id": "nd_docs_prereq_bullet_2", "name": "本文 / 前提条件2の点", "type": "ellipse", "x": 374, "y": 849, "width": 5, "height": 5, "fill": "#1f2328", "stroke": "#1f2328", "strokeWidth": 0 },
        { "id": "nd_docs_prereq_2", "name": "本文 / インストール不要", "type": "text", "x": 390, "y": 838, "width": 700, "height": 58, "content": "You don't need to know how to code, use the command line, or install Git (the version control\nsoftware that GitHub is built on).", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },

        { "id": "nd_docs_step1_top_rule", "name": "Step 1 / 上罫線", "type": "rectangle", "x": 350, "y": 912, "width": 740, "height": 1, "fill": "#d8dee4", "stroke": "#d8dee4", "strokeWidth": 0, "cornerRadius": 0 },
        { "id": "nd_docs_step1_heading", "name": "Step 1 / 見出し", "type": "text", "x": 350, "y": 958, "width": 510, "height": 39, "content": "Step 1: Create a repository", "fontSize": 24, "color": "#1f2328", "textAlign": "left", "fontFamily": "system", "fontWeight": 700 },
        { "id": "nd_docs_step1_anchor", "name": "Step 1 / 見出しリンク", "type": "text", "x": 657, "y": 966, "width": 28, "height": 25, "content": "↗", "fontSize": 17, "color": "#57606a", "textAlign": "center" },
        { "id": "nd_docs_step1_paragraph_1", "name": "Step 1 / リポジトリとは", "type": "text", "x": 350, "y": 1014, "width": 740, "height": 82, "content": "The first thing we'll do is create a repository. You can think of a repository as a folder that contains\nrelated items, such as files, images, videos, or even other folders. A repository usually groups\ntogether items that belong to the same \"project\" or thing you're working on.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_paragraph_2", "name": "Step 1 / README の説明", "type": "text", "x": 350, "y": 1108, "width": 740, "height": 56, "content": "Often, repositories include a README file, a file with information about your project. README files\nare written in Markdown, which is an easy-to-read, easy-to-write language for formatting plain text.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_links_prefix", "name": "Step 1 / 参考リンク前文", "type": "text", "x": 350, "y": 1160, "width": 461, "height": 27, "content": "You can learn more about Markdown and README files in", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_link_1", "name": "Step 1 / 書式リンク", "type": "text", "x": 808, "y": 1160, "width": 282, "height": 27, "content": "Basic writing and formatting syntax", "fontSize": 16, "color": "#0969da", "textAlign": "left" },
        { "id": "nd_docs_step1_links_and", "name": "Step 1 / and", "type": "text", "x": 350, "y": 1185, "width": 36, "height": 27, "content": "and", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_link_2", "name": "Step 1 / プロフィールリンク", "type": "text", "x": 383, "y": 1185, "width": 264, "height": 27, "content": "Managing your profile README.", "fontSize": 16, "color": "#0969da", "textAlign": "left" },
        { "id": "nd_docs_step1_paragraph_3", "name": "Step 1 / README を追加", "type": "text", "x": 350, "y": 1228, "width": 740, "height": 56, "content": "GitHub lets you add a README file at the same time you create your new repository. GitHub also\noffers other common options such as a license file, but you do not have to select any of them now.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_your", "name": "Step 1 / Your", "type": "text", "x": 350, "y": 1294, "width": 44, "height": 28, "content": "Your", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_code_bg", "name": "Step 1 / hello-world 背景", "type": "rectangle", "x": 390, "y": 1296, "width": 105, "height": 24, "fill": "#f6f8fa", "stroke": "#f6f8fa", "strokeWidth": 0, "cornerRadius": 4 },
        { "id": "nd_docs_step1_code", "name": "Step 1 / hello-world", "type": "text", "x": 394, "y": 1295, "width": 98, "height": 27, "content": "hello-world", "fontSize": 14, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_paragraph_4a", "name": "Step 1 / アイデアの置き場", "type": "text", "x": 498, "y": 1294, "width": 592, "height": 28, "content": "repository can be a place where you store ideas, resources, or even share and", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_paragraph_4b", "name": "Step 1 / 議論の場所", "type": "text", "x": 350, "y": 1319, "width": 740, "height": 28, "content": "discuss things with others.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },

        { "id": "nd_docs_step1_badge_1", "name": "Step 1 / 手順1の番号背景", "type": "rectangle", "x": 350, "y": 1358, "width": 34, "height": 26, "fill": "#eaeef2", "stroke": "#eaeef2", "strokeWidth": 0, "cornerRadius": 4 },
        { "id": "nd_docs_step1_number_1", "name": "Step 1 / 手順1の番号", "type": "text", "x": 355, "y": 1358, "width": 23, "height": 26, "content": "1", "fontSize": 16, "color": "#1f2328", "textAlign": "center" },
        { "id": "nd_docs_step1_instruction_1", "name": "Step 1 / 新規リポジトリの選択", "type": "text", "x": 390, "y": 1357, "width": 700, "height": 29, "content": "In the upper-right corner of any page, select +, then click New repository.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },

        { "id": "nd_docs_figure_canvas", "name": "Step 1 の図 / GitHub 画面背景", "type": "rectangle", "x": 390, "y": 1404, "width": 370, "height": 265, "fill": "#ffffff", "stroke": "#d8dee4", "strokeWidth": 1, "cornerRadius": 5 },
        { "id": "nd_docs_figure_toolbar", "name": "Step 1 の図 / ツールバー", "type": "rectangle", "x": 391, "y": 1405, "width": 368, "height": 38, "fill": "#f6f8fa", "stroke": "#f6f8fa", "strokeWidth": 0, "cornerRadius": 0 },
        { "id": "nd_docs_figure_toolbar_rule", "name": "Step 1 の図 / ツールバー下罫線", "type": "rectangle", "x": 391, "y": 1442, "width": 368, "height": 1, "fill": "#d8dee4", "stroke": "#d8dee4", "strokeWidth": 0, "cornerRadius": 0 },
        { "id": "nd_docs_figure_toolbar_text", "name": "Step 1 の図 / ツールバーのアイコン", "type": "text", "x": 405, "y": 1409, "width": 300, "height": 26, "content": "〉_       ＋  ⌄      ◉      ↕      ▣", "fontSize": 15, "color": "#57606a", "textAlign": "left" },
        { "id": "nd_docs_figure_avatar", "name": "Step 1 の図 / アバター", "type": "ellipse", "x": 724, "y": 1413, "width": 22, "height": 22, "fill": "#ddf4ff", "stroke": "#d8dee4", "strokeWidth": 1 },
        { "id": "nd_docs_figure_avatar_text", "name": "Step 1 の図 / アバターの記号", "type": "text", "x": 726, "y": 1411, "width": 18, "height": 25, "content": "●", "fontSize": 15, "color": "#1f2328", "textAlign": "center" },
        { "id": "nd_docs_figure_background_rule", "name": "Step 1 の図 / 背景の区切り", "type": "rectangle", "x": 392, "y": 1488, "width": 366, "height": 1, "fill": "#d8dee4", "stroke": "#d8dee4", "strokeWidth": 0, "cornerRadius": 0 },
        { "id": "nd_docs_figure_background_label", "name": "Step 1 の図 / 背景の文字", "type": "text", "x": 610, "y": 1527, "width": 130, "height": 25, "content": "Issues", "fontSize": 14, "color": "#57606a", "textAlign": "left" },
        { "id": "nd_docs_figure_green", "name": "Step 1 の図 / 背景の緑ボタン", "type": "rectangle", "x": 586, "y": 1536, "width": 42, "height": 28, "fill": "#1f883d", "stroke": "#1f883d", "strokeWidth": 0, "cornerRadius": 5 },
        { "id": "nd_docs_figure_menu", "name": "Step 1 の図 / 新規作成メニュー", "type": "rectangle", "x": 407, "y": 1446, "width": 184, "height": 210, "fill": "#ffffff", "stroke": "#d8dee4", "strokeWidth": 1, "cornerRadius": 10 },
        { "id": "nd_docs_figure_highlight", "name": "Step 1 の図 / オレンジの強調枠", "type": "rectangle", "x": 417, "y": 1456, "width": 149, "height": 34, "fill": "#ffffff", "stroke": "#bf5700", "strokeWidth": 2, "cornerRadius": 6 },
        { "id": "nd_docs_figure_menu_1", "name": "Step 1 の図 / New repository", "type": "text", "x": 426, "y": 1461, "width": 147, "height": 25, "content": "▣  New repository", "fontSize": 13, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_figure_menu_2", "name": "Step 1 の図 / Import repository", "type": "text", "x": 426, "y": 1496, "width": 155, "height": 25, "content": "▤  Import repository", "fontSize": 13, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_figure_menu_line_1", "name": "Step 1 の図 / メニュー区切り1", "type": "rectangle", "x": 408, "y": 1528, "width": 182, "height": 1, "fill": "#d8dee4", "stroke": "#d8dee4", "strokeWidth": 0, "cornerRadius": 0 },
        { "id": "nd_docs_figure_menu_3", "name": "Step 1 の図 / New codespace", "type": "text", "x": 426, "y": 1540, "width": 155, "height": 25, "content": "▣  New codespace", "fontSize": 13, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_figure_menu_4", "name": "Step 1 の図 / New gist", "type": "text", "x": 426, "y": 1575, "width": 155, "height": 25, "content": "〈〉  New gist", "fontSize": 13, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_figure_menu_line_2", "name": "Step 1 の図 / メニュー区切り2", "type": "rectangle", "x": 408, "y": 1607, "width": 182, "height": 1, "fill": "#d8dee4", "stroke": "#d8dee4", "strokeWidth": 0, "cornerRadius": 0 },
        { "id": "nd_docs_figure_menu_5", "name": "Step 1 の図 / New organization", "type": "text", "x": 426, "y": 1618, "width": 155, "height": 25, "content": "♙  New organization", "fontSize": 13, "color": "#1f2328", "textAlign": "left" },

        { "id": "nd_docs_step1_badge_2", "name": "Step 1 / 手順2の番号背景", "type": "rectangle", "x": 350, "y": 1695, "width": 34, "height": 26, "fill": "#eaeef2", "stroke": "#eaeef2", "strokeWidth": 0, "cornerRadius": 4 },
        { "id": "nd_docs_step1_number_2", "name": "Step 1 / 手順2の番号", "type": "text", "x": 355, "y": 1695, "width": 23, "height": 26, "content": "2", "fontSize": 16, "color": "#1f2328", "textAlign": "center" },
        { "id": "nd_docs_step1_instruction_2", "name": "Step 1 / リポジトリ名", "type": "text", "x": 390, "y": 1694, "width": 700, "height": 29, "content": "In the \"Repository name\" box, type hello-world.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_badge_3", "name": "Step 1 / 手順3の番号背景", "type": "rectangle", "x": 350, "y": 1750, "width": 34, "height": 26, "fill": "#eaeef2", "stroke": "#eaeef2", "strokeWidth": 0, "cornerRadius": 4 },
        { "id": "nd_docs_step1_number_3", "name": "Step 1 / 手順3の番号", "type": "text", "x": 355, "y": 1750, "width": 23, "height": 26, "content": "3", "fontSize": 16, "color": "#1f2328", "textAlign": "center" },
        { "id": "nd_docs_step1_instruction_3", "name": "Step 1 / 説明欄", "type": "text", "x": 390, "y": 1749, "width": 700, "height": 58, "content": "In the \"Description\" box, type a short description. For example, type \"This repository is for\npracticing the GitHub Flow.\"", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_badge_4", "name": "Step 1 / 手順4の番号背景", "type": "rectangle", "x": 350, "y": 1828, "width": 34, "height": 26, "fill": "#eaeef2", "stroke": "#eaeef2", "strokeWidth": 0, "cornerRadius": 4 },
        { "id": "nd_docs_step1_number_4", "name": "Step 1 / 手順4の番号", "type": "text", "x": 355, "y": 1828, "width": 23, "height": 26, "content": "4", "fontSize": 16, "color": "#1f2328", "textAlign": "center" },
        { "id": "nd_docs_step1_instruction_4", "name": "Step 1 / 公開範囲", "type": "text", "x": 390, "y": 1827, "width": 700, "height": 29, "content": "Select whether your repository will be Public or Private.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_badge_5", "name": "Step 1 / 手順5の番号背景", "type": "rectangle", "x": 350, "y": 1882, "width": 34, "height": 26, "fill": "#eaeef2", "stroke": "#eaeef2", "strokeWidth": 0, "cornerRadius": 4 },
        { "id": "nd_docs_step1_number_5", "name": "Step 1 / 手順5の番号", "type": "text", "x": 355, "y": 1882, "width": 23, "height": 26, "content": "5", "fontSize": 16, "color": "#1f2328", "textAlign": "center" },
        { "id": "nd_docs_step1_instruction_5", "name": "Step 1 / README 追加", "type": "text", "x": 390, "y": 1881, "width": 700, "height": 29, "content": "Select Add a README file.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_badge_6", "name": "Step 1 / 手順6の番号背景", "type": "rectangle", "x": 350, "y": 1936, "width": 34, "height": 26, "fill": "#eaeef2", "stroke": "#eaeef2", "strokeWidth": 0, "cornerRadius": 4 },
        { "id": "nd_docs_step1_number_6", "name": "Step 1 / 手順6の番号", "type": "text", "x": 355, "y": 1936, "width": 23, "height": 26, "content": "6", "fontSize": 16, "color": "#1f2328", "textAlign": "center" },
        { "id": "nd_docs_step1_instruction_6", "name": "Step 1 / リポジトリ作成", "type": "text", "x": 390, "y": 1935, "width": 700, "height": 29, "content": "Click Create repository.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_step1_bottom_rule", "name": "Step 1 / 下罫線", "type": "rectangle", "x": 350, "y": 1991, "width": 740, "height": 1, "fill": "#d8dee4", "stroke": "#d8dee4", "strokeWidth": 0, "cornerRadius": 0 },

        { "id": "nd_docs_toc_heading", "name": "右目次 / IN THIS ARTICLE", "type": "text", "x": 1154, "y": 196, "width": 225, "height": 23, "content": "IN THIS ARTICLE", "fontSize": 12, "color": "#57606a", "textAlign": "left", "fontFamily": "system", "fontWeight": 600 },
        { "id": "nd_docs_toc_1", "name": "右目次 / Introduction", "type": "text", "x": 1169, "y": 246, "width": 245, "height": 28, "content": "Introduction", "fontSize": 14, "color": "#57606a", "textAlign": "left" },
        { "id": "nd_docs_toc_2", "name": "右目次 / Step 1", "type": "text", "x": 1169, "y": 286, "width": 245, "height": 28, "content": "Step 1: Create a repository", "fontSize": 14, "color": "#57606a", "textAlign": "left" },
        { "id": "nd_docs_toc_3", "name": "右目次 / Step 2", "type": "text", "x": 1169, "y": 326, "width": 245, "height": 28, "content": "Step 2: Create a branch", "fontSize": 14, "color": "#57606a", "textAlign": "left" },
        { "id": "nd_docs_toc_4", "name": "右目次 / Step 3", "type": "text", "x": 1169, "y": 366, "width": 245, "height": 51, "content": "Step 3: Make and commit\nchanges", "fontSize": 14, "color": "#57606a", "textAlign": "left" },
        { "id": "nd_docs_toc_5", "name": "右目次 / Step 4", "type": "text", "x": 1169, "y": 420, "width": 245, "height": 28, "content": "Step 4: Open a pull request", "fontSize": 14, "color": "#57606a", "textAlign": "left" },
        { "id": "nd_docs_toc_6", "name": "右目次 / Step 5", "type": "text", "x": 1169, "y": 460, "width": 245, "height": 28, "content": "Step 5: Merge your pull request", "fontSize": 14, "color": "#57606a", "textAlign": "left" },
