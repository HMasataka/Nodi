        { "id": "nd_docs_article_border", "name": "本文 / 右罫線", "type": "rectangle", "x": 1114, "y": 180, "width": 1, "height": 1850, "fill": "#d8dee4", "stroke": "#d8dee4", "strokeWidth": 0, "cornerRadius": 0 },
        { "id": "nd_docs_article_title", "name": "本文 / Hello World 見出し", "type": "text", "x": 350, "y": 210, "width": 690, "height": 45, "content": "Hello World", "fontSize": 40, "color": "#1f2328", "textAlign": "left", "fontFamily": "system", "fontWeight": 700 },
        { "id": "nd_docs_article_lead", "name": "本文 / リード", "type": "text", "x": 350, "y": 253, "width": 740, "height": 30, "content": "Follow this Hello World exercise to learn GitHub's pull request workflow.", "fontSize": 16, "color": "#57606a", "textAlign": "left" },
        { "id": "nd_docs_copy_button", "name": "本文 / Copy markdown 背景", "type": "rectangle", "x": 350, "y": 302, "width": 178, "height": 34, "fill": "#f6f8fa", "stroke": "#f6f8fa", "strokeWidth": 0, "cornerRadius": 18 },
