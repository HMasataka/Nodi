        { "id": "nd_docs_intro_heading", "name": "本文 / Introduction", "type": "text", "x": 350, "y": 408, "width": 400, "height": 38, "content": "Introduction", "fontSize": 24, "color": "#1f2328", "textAlign": "left", "fontFamily": "system", "fontWeight": 700 },
        { "id": "nd_docs_intro_anchor", "name": "本文 / 見出しリンク", "type": "text", "x": 497, "y": 412, "width": 28, "height": 26, "content": "↗", "fontSize": 17, "color": "#57606a", "textAlign": "center" },
        { "id": "nd_docs_intro_paragraph", "name": "本文 / イントロ説明", "type": "text", "x": 350, "y": 460, "width": 740, "height": 73, "content": "This tutorial teaches you GitHub essentials like repositories, branches, commits, and pull requests.\nYou'll create your own Hello World repository and learn GitHub's pull request workflow,\na popular way to create and review code.", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
        { "id": "nd_docs_quickstart", "name": "本文 / quickstart 導入", "type": "text", "x": 350, "y": 554, "width": 740, "height": 29, "content": "In this quickstart guide, you will:", "fontSize": 16, "color": "#1f2328", "textAlign": "left" },
